# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings → Environment Variables.

# --- Public (shipped to the browser) -------------------------------------------
# Canonical origin, no trailing slash. Defaults to https://www.viralconcepts.co
NEXT_PUBLIC_SITE_URL=
# Cloudflare Turnstile site key (public by design)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) ------------------------------
# Resend API key for lead emails
RESEND_API_KEY=
# Comma-separated recipients of new enquiries
LEAD_TO_EMAIL=
# Verified sender, e.g. "Viral Concepts Website <website@viralconcepts.co>"
LEAD_FROM_EMAIL=
# Cloudflare Turnstile secret key
TURNSTILE_SECRET_KEY=
# Send the visitor a confirmation email (default true)
LEAD_AUTO_REPLY=true

# --- Optional switches -----------------------------------------------------------
# Show proposed/draft content with a review banner (local review only; ignored on Vercel production)
CONTENT_PREVIEW=false
# Allow indexing on non-Vercel hosts (Vercel production is indexable automatically)
SITE_INDEXABLE=false
# Local QA without keys or network: "test" skips Turnstile and logs instead of emailing.
# Refused on the Vercel production deployment.
LEAD_FORM_MODE=

